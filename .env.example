# Railway Postgres connection string — copy to .env and fill in
DATABASE_URL="postgresql://user:password@host:5432/railway"

# WhatsApp number for the footer's "Kirim masukan" link, digits only, with
# country code and no leading + (e.g. 6281299275403). The link is hidden when
# this is unset.
NEXT_PUBLIC_FEEDBACK_WA=""

# Umami Cloud website id (a UUID, shown in the site's settings). Set it on
# the production deploy only; analytics stays off when this is unset, so leave
# it empty locally. It is inlined at build time, so redeploy after changing it.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
